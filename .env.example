# Copy to .env. These local-only database credentials match docker-compose.yml.
NODE_ENV=development
DATABASE_URL=postgresql://shorts:shorts_local@127.0.0.1:5432/shorts
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
API_HOST=127.0.0.1
API_PORT=3001
STORAGE_PROVIDER=local
STORAGE_ROOT=.data/storage
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
# S3/R2 uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or the SDK credential chain.
MAX_UPLOAD_BYTES=21474836480
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_TTL_HOURS=24
MAX_ACTIVE_UPLOADS=5
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_MS=14400000
WORKER_CONCURRENCY=2
SESSION_HOURS=24
TIMEZONE=Africa/Accra
LOG_LEVEL=info
# For the user:create command only; never sent to the browser. Choose your own password.
OWNER_EMAIL=
OWNER_PASSWORD=
# Reserved for later phases; not required or used in Phase 1.
YOUTUBE_MODE=mock
OPENAI_API_KEY=
AI_REASONING_MODEL=
AI_VISION_MODEL=
AI_FAST_MODEL=
AI_TRANSCRIPTION_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ENCRYPTION_KEY=
