# Copy to .env. These local-only database credentials match docker-compose.yml.
NODE_ENV=development
DATABASE_URL=postgresql://shorts:shorts_local@127.0.0.1:5432/shorts
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
API_HOST=127.0.0.1
API_PORT=3001
STORAGE_PROVIDER=local
STORAGE_ROOT=.data/storage
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
# S3/R2 uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or the SDK credential chain.
MAX_UPLOAD_BYTES=21474836480
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_TTL_HOURS=24
MAX_ACTIVE_UPLOADS=5
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_MS=14400000
WORKER_CONCURRENCY=2
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_MS=7200000
# Optional absolute Chrome/Chrome Headless Shell executable for Remotion rendering.
REMOTION_BROWSER_EXECUTABLE=
ANALYSIS_FPS=1
ANALYSIS_CANDIDATE_LIMIT=24
PROXY_MAX_WIDTH=720
AI_MODE=mock
AI_EMBEDDING_MODEL=
AI_FINALIST_LIMIT=24
# Safety ceiling; the planner generates only candidates that pass adaptive quality gates.
SHORTS_PER_SOURCE_LIMIT=24
DUPLICATE_COMPOSITE_THRESHOLD=0.82
DUPLICATE_SHORTER_OVERLAP_THRESHOLD=0.75
DUPLICATE_VISUAL_THRESHOLD=0.80
# Optional JSON map keyed by exact game name, e.g. {"EA Sports FC":{"compositeThreshold":0.84}}
DUPLICATE_GAME_OVERRIDES={}
AI_TIMEOUT_MS=120000
# Required only with AI_MODE=openai. Prices are explicit estimates for your chosen model.
OPENAI_API_KEY=
HIGGSFIELD_ENABLED=false
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# Set these to model paths confirmed in your Higgsfield account's current catalog.
HIGGSFIELD_MODEL_TEXT_TO_VIDEO=
HIGGSFIELD_MODEL_IMAGE_TO_VIDEO=
HIGGSFIELD_MAX_GENERATIONS_PER_SHORT=1
HIGGSFIELD_MAX_COST_PER_SHORT_USD=2
HIGGSFIELD_MAX_COST_PER_BATCH_USD=20
AI_VISION_MODEL=
# Optional per-stage overrides; these are the documented defaults.
AI_DISCOVERY_MODEL=gpt-5.6-luna
AI_METADATA_MODEL=gpt-5.6-luna
AI_VERIFICATION_MODEL=gpt-5.6-terra
AI_EDIT_MODEL=gpt-5.6-terra
AI_EDITORIAL_QC_MODEL=gpt-5.6-terra
AI_FINAL_RANKING_MODEL=gpt-5.6-sol
AI_ESCALATION_MODEL=gpt-5.6-sol
# Set false only to retain the legacy single-stage vision ranking if Luna/Sol are unavailable.
AI_STAGED_RANKING_ENABLED=true
AI_INPUT_USD_PER_1M=0
AI_OUTPUT_USD_PER_1M=0
SESSION_HOURS=24
TIMEZONE=Africa/Accra
LOG_LEVEL=info
# For the user:create command only; never sent to the browser. Choose your own password.
OWNER_EMAIL=
OWNER_PASSWORD=
# Optional Phase 4 planning model. AI_VISION_MODEL is used as a fallback.
AI_REASONING_MODEL=
# Legacy per-clip transcription compatibility; source-level transcription uses routed models below.
AI_TRANSCRIPTION_MODEL=whisper-1
AI_TRANSCRIPTION_NORMAL_MODEL=gpt-4o-mini-transcribe
AI_TRANSCRIPTION_HIGH_MODEL=gpt-4o-transcribe
AI_TRANSCRIPTION_DIARIZE_MODEL=gpt-4o-transcribe-diarize
AI_TRANSCRIPTION_ALIGNMENT_MODEL=whisper-1
AI_TRANSCRIPTION_QUALITY=NORMAL
AI_TRANSCRIPTION_CHUNK_SECONDS=480
# YouTube is disabled in mock mode. Live requires all three server credentials below.
YOUTUBE_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register APP_URL/api/youtube/callback as Google's exact redirect URI.
# Generate a 32-byte random key encoded as 64 hex characters. Keep it stable and secret.
YOUTUBE_TOKEN_KEY=
# Periodic YouTube Analytics cadence and first-sync history window.
ANALYTICS_SYNC_INTERVAL_MINUTES=360
ANALYTICS_INITIAL_LOOKBACK_DAYS=90
# Phase 8 performance-learning cadence and evidence safeguards.
LEARNING_INTERVAL_MINUTES=360
LEARNING_MIN_SAMPLE_SIZE=5
LEARNING_MAX_ADJUSTMENT=0.15
# Phase 9 production-hardening guardrails.
WATCHDOG_STALE_JOB_MINUTES=60
BACKUP_MAX_AGE_HOURS=24
# Optional HTTPS endpoint for mirroring critical operational alerts.
ALERT_WEBHOOK_URL=
